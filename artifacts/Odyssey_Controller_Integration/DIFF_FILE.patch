+struct WmrControllerState
+{
+  bool connected = false;
+  bool left = false;
+  bool menu = false;
+  bool home = false;
+  bool squeeze = false;
+  bool thumbstick_click = false;
+  bool trackpad_click = false;
+  bool trackpad_touch = false;
+  float trigger = 0.f;
+  float thumbstick_x = 0.f;
+  float thumbstick_y = 0.f;
