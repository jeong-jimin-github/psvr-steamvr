+  bool have_ticks_ = false;
+};
diff --git "a/C:\\Users\\jm\\AppData\\Local\\Temp\\odyssey_empty_4979817029d9401f860253787459ca4d" "b/C:\\Users\\jm\\Documents\\psvr-steamvr\\src\\wmr_hid.cpp"
index e69de29..782fd75 100644
--- "a/C:\\Users\\jm\\AppData\\Local\\Temp\\odyssey_empty_4979817029d9401f860253787459ca4d"
